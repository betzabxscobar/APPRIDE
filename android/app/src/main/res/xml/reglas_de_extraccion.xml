<?xml version="1.0" encoding="utf-8"?>
<!-- Lo mismo que reglas_de_respaldo.xml, pero para Android 12 en adelante, que
     usa otro formato y ademas distingue el respaldo en la nube del traspaso
     directo entre dos telefonos. La sesion no viaja en ninguno de los dos. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    </device-transfer>
</data-extraction-rules>
