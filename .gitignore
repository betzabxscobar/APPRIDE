# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# El .vscode que genera la extensión de CMake guarda rutas absolutas de la
# máquina de cada uno («C:/Users/.../APPRIDE/windows/runner»), que en el equipo
# de al lado no existen. Si algún día hay una configuración de lanzamiento que
# valga la pena compartir, se añade a mano con `git add -f`.
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Credenciales temporales del equipo administrativo. Nunca se versionan:
# se entregan por separado y se pasan al compilar con --dart-define-from-file.
# La plantilla sin valores sí se versiona.
/config/credenciales-administrativas.json

# Configuracion local de herramientas de desarrollo. Lleva rutas absolutas de
# la maquina de cada quien, asi que no sirve compartirla.
.claude/

# Cache incremental del compilador de Kotlin. La crea el build de Android y
# solo vale para esta maquina.
/android/.kotlin/
# Widget Preview related
.widget_preview/
